<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
    <id>io.github.infertop.infertop</id>

    <name>Infertop</name>
    <summary>GPU and llama.cpp inference monitor for AMD Strix Halo</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <developer_name>BaronMuchhumpin (Infertop fork) — based on nvtop by Maxime Schmitt</developer_name>

    <description>
        <p>Infertop is an AMD Ryzen AI MAX+ (Strix Halo) fork of nvtop. It reports true dynamic GPU memory (GTT-backed, not the 512 MB carveout) and shows live tokens/s from llama.cpp servers.</p>
    </description>

    <launchable type="desktop-id">infertop.desktop</launchable>

    <icon type="cached">infertop.svg</icon>

    <categories>
        <category>System</category>
        <category>Monitor</category>
    </categories>

    <url type="homepage">https://github.com/Syllo/nvtop</url>

    <screenshots>
        <screenshot type="default">
            <caption>The infertop interface</caption>
            <image>https://raw.githubusercontent.com/Syllo/infertop/master/screenshot/INFERTOP_ex1.png</image>
        </screenshot>
        <screenshot>
            <caption>The infertop option screen</caption>
            <image>https://raw.githubusercontent.com/Syllo/infertop/master/screenshot/Nvtop-config.png</image>
        </screenshot>
    </screenshots>

    <provides>
        <binary>infertop</binary>
    </provides>
    <releases>
    <release version="@infertop_VERSION_MAJOR@.@infertop_VERSION_MINOR@.@infertop_VERSION_PATCH@" date="@TODAY_ISO_8601@"></release>
    </releases>
</component>
